# === Telegram ===
# Токен бота от @BotFather (передаётся владельцем позже)
BOT_TOKEN=

# ID администраторов через запятую (получить у @userinfobot)
ADMIN_IDS=

# Прокси для доступа к Telegram (сервер вне РФ). В России api.telegram.org
# часто заблокирован по DPI — тогда без прокси бот не подключится.
# Форматы: http://user:pass@host:port  или  socks5://user:pass@host:port
# Оставьте пустым, если сервер имеет прямой доступ к Telegram.
TELEGRAM_PROXY=

# === Платежи ===
# Провайдер Telegram Payments (получить у @BotFather -> /mybots -> Payments).
# Для оплаты российскими картами используйте ЮKassa; для валютных — Stripe.
# Оставьте пустым, чтобы включить оплату Telegram Stars (XTR).
PAYMENT_PROVIDER_TOKEN=

# Валюта прайса. USD для карт, XTR для Telegram Stars.
CURRENCY=USD

# === Обход региональных ограничений TikTok ===
# TikTok блокирует загрузку из РФ. Весь исходящий трафик к TikTok идёт
# через этот прокси (сервер вне РФ). Формат:
#   http://user:pass@host:port  или  socks5://user:pass@host:port
TIKTOK_PROXY=

# === TikTok Content Posting API (официальный) ===
# Приложение регистрируется на https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# URL для OAuth callback (публичный HTTPS). Пользователь привязывает
# свой аккаунт TikTok, бот получает access_token для загрузки от его имени.
TIKTOK_REDIRECT_URI=

# === Прочее ===
DATABASE_PATH=bot.db
# Часовой пояс для суточного сброса квот
TIMEZONE=Europe/Moscow
