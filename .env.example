# === Telegram ===
# Токен бота от @BotFather (передаётся владельцем позже)
BOT_TOKEN=

# ID администраторов через запятую (получить у @userinfobot)
ADMIN_IDS=

# Прокси для доступа к Telegram (сервер вне РФ). В России api.telegram.org
# часто заблокирован по DPI — тогда без прокси бот не подключится.
# Форматы: http://user:pass@host:port  или  socks5://user:pass@host:port
# Оставьте пустым, если сервер имеет прямой доступ к Telegram.
TELEGRAM_PROXY=

# === Платежи ===
# Приоритет: если заданы ключи Robokassa (ниже) — используется Robokassa.
# Иначе, если задан PAYMENT_PROVIDER_TOKEN — Telegram Payments.
# Иначе — Telegram Stars (XTR).

# --- Robokassa ---
# Из личного кабинета Robokassa (Технические настройки).
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# 1 = тестовый режим (тестовые пароли), 0 = боевой.
ROBOKASSA_TEST=0
# Тарифы заданы в долларах, Robokassa берёт рубли. Курс пересчёта $ -> ₽.
ROBOKASSA_USD_RATE=100
# Публичный адрес веб-сервера бота (для ResultURL/OAuth). Напр. http://IP:8080
PUBLIC_BASE_URL=

# --- Telegram Payments (альтернатива) ---
# Провайдер Telegram Payments (@BotFather -> /mybots -> Payments). Stripe и т.п.
# Оставьте пустым, чтобы (при отсутствии Robokassa) включить Telegram Stars (XTR).
PAYMENT_PROVIDER_TOKEN=

# Валюта прайса для Telegram Payments. USD для карт, XTR для Stars.
CURRENCY=USD

# === Обход региональных ограничений TikTok ===
# TikTok блокирует загрузку из РФ. Весь исходящий трафик к TikTok идёт
# через этот прокси (сервер вне РФ). Формат:
#   http://user:pass@host:port  или  socks5://user:pass@host:port
TIKTOK_PROXY=

# === TikTok Content Posting API (официальный) ===
# Приложение регистрируется на https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# URL для OAuth callback (публичный HTTPS). Пользователь привязывает
# свой аккаунт TikTok, бот получает access_token для загрузки от его имени.
TIKTOK_REDIRECT_URI=

# Режим загрузки в TikTok:
#   draft  — в «Черновики» (scope video.upload), работает в sandbox без аудита;
#   direct — прямая публикация (scope video.publish, нужен аудит приложения).
TIKTOK_UPLOAD_MODE=draft

# === Прочее ===
DATABASE_PATH=bot.db
# Часовой пояс для суточного сброса квот
TIMEZONE=Europe/Moscow
